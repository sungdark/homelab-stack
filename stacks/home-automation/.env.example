# ============================================
# Home Automation Stack — Environment
# ============================================
# Copy to .env and fill in your values

# ── General ──────────────────────────────────
DOMAIN=yourdomain.com
TZ=Asia/Shanghai

# ── MQTT Broker (Mosquitto) ──────────────────
MQTT_USERNAME=mosquitto
MQTT_PASSWORD=change_me_secure_password

# ── Zigbee2MQTT ──────────────────────────────
# Your USB Zigbee stick device path
# Common: /dev/ttyACM0, /dev/ttyUSB0, /dev/ttyACM1
ZIGBEE_DEVICE=/dev/ttyACM0

# ── URLs (for reference) ─────────────────────
# Home Assistant:  http://ha.{DOMAIN}  (port 8123)
# Node-RED:        http://nodered.{DOMAIN}  (port 1880)
# Zigbee2MQTT UI:  http://zigbee.{DOMAIN}  (port 8080)
# Mosquitto:       mqtt://{DOMAIN}:1883
